<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Admin Panel</title>
  <link rel="stylesheet" href="/css/admin-layout.css">
</head>
<body>
<div class="admin-wrapper">

  <aside class="sidebar">
    <div class="brand">
      <span class="brand-mark">A</span>
      <span class="brand-text">Admin Panel</span>
    </div>

    <nav class="nav">
      <a href="/admin/dashboard" class="nav-link <%= active === 'dashboard' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        <span>Dashboard Home</span>
      </a>
      <a href="/admin/users" class="nav-link <%= active === 'users' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>User Management</span>
      </a>
      <a href="/admin/products" class="nav-link <%= active === 'products' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
        <span>Product Management</span>
      </a>
  
      <a href="/admin/orders" class="nav-link <%= active === 'orders' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>Order Management</span>
      </a>

      <a href="/admin/overview" class="nav-link <%= active === 'overview' ? 'active' : '' %>">
        <svg class="icon" viewBox="0 0 24 24"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span>overview</span>
      </a>
</nav>



    <form action="/admin/logout" method="POST" class="logout-form">
      <button type="submit" class="logout-btn">
        <svg class="icon" viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        <span>Logout</span>
      </button>
    </form>
  </aside>

  <div class="admin-main">
    <header class="topbar">
      <h1 class="page-title"><%= title %></h1>
      <div class="admin-info">
      <span class="avatar">
    <%= (typeof admin !== "undefined" && admin?.name)
        ? admin.name.charAt(0).toUpperCase()
        : "A" %>
</span>

<span class="admin-name">
    <%= (typeof admin !== "undefined" && admin?.name)
        ? admin.name
        : "Admin" %>
</span>
      </div>
    </header>


    <main class="admin-content">