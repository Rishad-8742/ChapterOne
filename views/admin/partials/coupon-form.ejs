
<section class="coupon-form-section" id="couponFormSection" hidden>

    <div class="section-header">
        <div>
            <h2 id="formTitle">Create New Coupon</h2>
            <p>Configure the discount and usage rules for this offer.</p>
        </div>

        <button type="button" id="closeCouponForm" class="secondary-btn">
            Close
        </button>
    </div>

    <form id="couponForm">
        <input type="hidden" id="couponId">

        <div class="form-grid">

            <!-- Coupon Code -->
            <div class="form-group">
                <label for="code">Coupon Code</label>
                <input
                    type="text"
                    id="code"
                    name="code"
                    placeholder="Example: BOOK20"
                    maxlength="30"
                    required
                >
                <small>3–30 letters, numbers, hyphens or underscores.</small>
            </div>

            <!-- Discount Type -->
            <div class="form-group">
                <label for="discountType">Discount Type</label>
                <select id="discountType" name="discountType" required>
                    <option value="percentage">Percentage (%)</option>
                    <option value="fixed">Fixed Amount (₹)</option>
                </select>
            </div>

            <!-- Discount Value -->
            <div class="form-group">
                <label for="discountValue">Discount Value</label>
                <input
                    type="number"
                    id="discountValue"
                    name="discountValue"
                    min="0.01"
                    step="0.01"
                    placeholder="Enter discount value"
                    required
                >
                <small id="discountValueHelp">
                    Enter a percentage between 0 and 100.
                </small>
            </div>

            <!-- Maximum Discount -->
            <div class="form-group" id="maxDiscountGroup">
                <label for="maxDiscount">Maximum Discount (₹)</label>
                <input
                    type="number"
                    id="maxDiscount"
                    name="maxDiscount"
                    min="0.01"
                    step="0.01"
                    placeholder="Example: 200"
                >
                <small>Maximum amount discounted for percentage coupons.</small>
            </div>

            <!-- Minimum Purchase -->
            <div class="form-group">
                <label for="minPurchase">Minimum Order Amount (₹)</label>
                <input
                    type="number"
                    id="minPurchase"
                    name="minPurchase"
                    min="0"
                    step="0.01"
                    value="0"
                >
                <small>Minimum cart value required to use this coupon.</small>
            </div>

            <!-- Total Usage Limit -->
            <div class="form-group">
                <label for="usageLimit">Maximum Usage Count</label>
                <input
                    type="number"
                    id="usageLimit"
                    name="usageLimit"
                    min="1"
                    step="1"
                    placeholder="Example: 100"
                    required
                >
                <small>Coupon expires when this usage count is reached.</small>
            </div>

            <!-- Start Date -->
            <div class="form-group">
                <label for="startDate">Start Date</label>
                <input
                    type="datetime-local"
                    id="startDate"
                    name="startDate"
                    required
                >
            </div>

            <!-- Expiry Date -->
            <div class="form-group">
                <label for="expiryDate">Expiry Date</label>
                <input
                    type="datetime-local"
                    id="expiryDate"
                    name="expiryDate"
                    required
                >
            </div>

            <!-- Initial Status -->
            <div class="form-group">
                <label for="isActive">Initial Status</label>
                <select id="isActive" name="isActive">
                    <option value="true">Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>

        </div>

        <div class="form-actions">
            <button
                type="button"
                id="cancelCouponForm"
                class="secondary-btn"
            >
                Cancel
            </button>

            <button
                type="submit"
                id="saveCouponBtn"
                class="primary-btn"
            >
                Save Coupon
            </button>
        </div>

    </form>
</section>
