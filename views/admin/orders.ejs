<%- include('partials/top', { title: 'Orders', active: 'orders' }) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin-orders.css">
<script src="/js/adminOrders.js" defer></script>

<section class="orders-page">

    <div class="orders-heading">
        <div>
            <h2>Order Management</h2>
            <p>Track purchases and manage customer deliveries.</p>
        </div>

        <button type="button" id="refreshOrders" class="refresh-btn">
            Refresh Orders
        </button>
    </div>

    <div class="order-stats">
        <div class="stat-card">
            <span>Total Orders</span>
            <h3 id="totalOrders">0</h3>
        </div>

        <div class="stat-card">
            <span>Pending</span>
            <h3 id="pendingOrders">0</h3>
        </div>

        <div class="stat-card">
            <span>Shipped</span>
            <h3 id="shippedOrders">0</h3>
        </div>

        <div class="stat-card">
            <span>Delivered</span>
            <h3 id="deliveredOrders">0</h3>
        </div>
    </div>

    <p id="pageMessage" class="message"
       role="status" aria-live="polite"></p>

    <section class="orders-card">

        <div class="orders-toolbar">
            <input
                type="search"
                id="orderSearch"
                placeholder="Search order ID or customer..."
                aria-label="Search orders">

            <select id="statusFilter" aria-label="Filter orders by status">
                <option value="ALL">All Statuses</option>
                <option value="PENDING">Pending</option>
                <option value="CONFIRMED">Confirmed</option>
                <option value="SHIPPED">Shipped</option>
                <option value="DELIVERED">Delivered</option>
                <option value="CANCELLED">Cancelled</option>
            </select>
        </div>

        <div class="orders-table-wrapper">
            <table class="orders-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Total</th>
                        <th>Payment</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody id="ordersBody">
                    <tr>
                        <td colspan="7" class="table-message">
                            Loading orders...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

    </section>

</section>

<!-- ============ ORDER DETAILS MODAL ============ -->
<div id="orderDetails" class="order-modal" hidden>
    <div class="order-modal__backdrop" data-close-modal></div>

    <div class="order-modal__dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="detailsTitle">

        <header class="order-modal__header">
            <button type="button" id="closeDetails"
                    class="modal-x" aria-label="Close order details">
                &times;
            </button>

            <p class="modal-eyebrow">Order details</p>
            <h2 id="detailsTitle">Order</h2>
            <p id="detailsDate" class="modal-date"></p>
            <span id="detailsBadge" class="modal-badge"></span>
        </header>

        <div class="order-modal__body">
            <p id="modalMessage" class="message"
               role="status" aria-live="polite"></p>

            <div id="detailsContent"></div>

            <section class="modal-card status-management">
                <div class="modal-card__title">
                    <span class="modal-icon">
                        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
                    </span>
                    Update status
                </div>

                <div class="status-controls">
                    <select id="newOrderStatus" aria-label="New order status">
                        <option value="PENDING">Pending</option>
                        <option value="CONFIRMED">Confirmed</option>
                        <option value="SHIPPED">Shipped</option>
                        <option value="DELIVERED">Delivered</option>
                        <option value="CANCELLED">Cancelled</option>
                    </select>

                    <button type="button" id="updateStatusBtn" class="update-btn">
                        Update Status
                    </button>
                </div>

                <p class="status-help">
                    Order status changes are validated by the server.
                </p>
            </section>
        </div>

        <footer class="order-modal__footer">
            <button type="button" id="closeDetailsFooter" class="close-btn">
                Close
            </button>
        </footer>
    </div>
</div>

<%- include('partials/bottom') %>
