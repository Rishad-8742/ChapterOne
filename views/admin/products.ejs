<%- include('partials/top', { title: 'Products', active: 'products' }) %>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/products.css">

<section class="products-page">

    <!-- Heading -->
    <div class="pp-heading">
        <div>
            <h2>Book Catalogue</h2>
            <p>Manage your books, pricing and stock levels.</p>
        </div>

        <a href="/admin/products/add" class="pp-add-btn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
            Add Book
        </a>
    </div>

    <div class="pp-card">

        <!-- Toolbar -->
        <div class="pp-toolbar">
            <div class="pp-search">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="text" id="searchInput" class="pp-input"
                       placeholder="Search title or author..."
                       aria-label="Search books">
            </div>

            <select id="stockFilter" class="pp-input pp-select" aria-label="Filter by stock">
                <option value="all">All stock</option>
                <option value="in">In stock</option>
                <option value="out">Out of stock</option>
            </select>
        </div>

        <!-- Table -->
        <div class="pp-table-wrap">
            <table class="pp-table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Language</th>
                        <th>Genre</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="productsBody"></tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="pp-footer">
            <span id="totalInfo" class="pp-total"></span>

            <div class="pp-pagination">
                <button type="button" id="prevBtn" class="pp-page-btn">Previous</button>
                <span id="pageInfo" class="pp-page-info"></span>
                <button type="button" id="nextBtn" class="pp-page-btn">Next</button>
            </div>
        </div>

    </div>
</section>


<!-- ============ ADD / EDIT MODAL ============ -->
<div id="productModal" class="pm-modal">
    <div class="pm-dialog" role="dialog" aria-modal="true" aria-labelledby="modalTitle">

        <header class="pm-header">
            <div>
                <p class="pm-eyebrow">Book catalogue</p>
                <h2 id="modalTitle">Add Book</h2>
            </div>

            <button type="button" id="pmClose" class="pm-x" aria-label="Close">&times;</button>
        </header>

        <form id="productForm" class="pm-form" novalidate>

            <div class="pm-body">

                <input type="hidden" id="productId">

                <div class="pm-layout">

                    <!-- LEFT: details -->
                    <div class="pm-main">

                        <h3 class="pm-section">Basic information</h3>

                        <div class="pm-grid">
                            <div class="pm-field">
                                <label for="title">Title</label>
                                <input type="text" id="title" class="pm-input" required>
                            </div>

                            <div class="pm-field">
                                <label for="author">Author</label>
                                <input type="text" id="author" class="pm-input" required>
                            </div>

                            <div class="pm-field">
                                <label for="language">Language</label>
                                <select id="language" class="pm-input" required>
                                    <option value="">Select language</option>
                                    <option value="English">English</option>
                                    <option value="Malayalam">Malayalam</option>
                                    <option value="Hindi">Hindi</option>
                                </select>
                            </div>

                            <div class="pm-field">
                                <label for="genre">Genre</label>
                                <select id="genre" class="pm-input" required>
                                    <option value="">Select genre</option>
                                    <option value="Fiction">Fiction</option>
                                    <option value="Mystery">Mystery</option>
                                    <option value="Romance">Romance</option>
                                    <option value="Science Fiction">Science Fiction</option>
                                    <option value="Fantasy">Fantasy</option>
                                    <option value="Self Help">Self Help</option>
                                </select>
                            </div>
                        </div>

                        <h3 class="pm-section">Pricing &amp; stock</h3>

                        <div class="pm-grid">
                            <div class="pm-field">
                                <label for="price">Price</label>
                                <div class="pm-prefix">
                                    <span>₹</span>
                                    <input type="number" id="price" class="pm-input"
                                           min="0" step="0.01" required>
                                </div>
                            </div>

                            <div class="pm-field">
                                <label for="stock">Stock</label>
                                <input type="number" id="stock" class="pm-input"
                                       min="0" step="1" required>
                            </div>
                        </div>

                        <h3 class="pm-section">Description</h3>

                        <div class="pm-field">
                            <label for="description">About this book</label>
                            <textarea id="description" class="pm-input" rows="5"></textarea>
                        </div>

                    </div>

                    <!-- RIGHT: covers -->
                    <aside class="pm-side">

                        <h3 class="pm-section">Book covers</h3>

                        <div class="pm-covers">

                            <!-- FRONT COVER -->
                            <div class="pm-field">
                                <span class="pm-label">Front</span>

                                <label for="image" class="pm-drop">
                                    <img id="imagePreview" class="pm-preview"
                                         alt="Front cover preview" hidden>

                                    <span class="pm-placeholder">
                                        <span class="pm-upload-icon">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
                                        </span>
                                        <strong>Front cover</strong>
                                        <small>Click to upload</small>
                                    </span>

                                    <span class="pm-change">Change image</span>

                                    <input type="file" id="image" name="image"
                                           accept="image/jpeg,image/png,image/webp" hidden>
                                </label>
                            </div>

                            <!-- BACK COVER -->
                            <div class="pm-field">
                                <span class="pm-label">Back</span>

                                <label for="image2" class="pm-drop">
                                    <img id="image2Preview" class="pm-preview"
                                         alt="Back cover preview" hidden>

                                    <span class="pm-placeholder">
                                        <span class="pm-upload-icon">
                                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4"/><path d="M7 9l5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
                                        </span>
                                        <strong>Back cover</strong>
                                        <small>Click to upload</small>
                                    </span>

                                    <span class="pm-change">Change image</span>

                                    <input type="file" id="image2" name="image2"
                                           accept="image/jpeg,image/png,image/webp" hidden>
                                </label>
                            </div>

                        </div>

                        <p class="pm-hint">JPG, PNG or WebP, up to 5 MB each. Leave empty to keep the current images.</p>

                    </aside>

                </div>

                <p id="formError" class="pm-error" role="alert"></p>

            </div>

            <footer class="pm-footer">
                <button type="button" id="cancelBtn" class="pm-btn pm-btn--ghost">
                    Cancel
                </button>

                <button type="submit" id="saveBtn" class="pm-btn pm-btn--primary">
                    Save
                </button>
            </footer>

        </form>
    </div>
</div>


<div id="toast" class="toast" role="status"></div>

<script src="/js/products.js"></script>

<%- include('partials/bottom') %>
