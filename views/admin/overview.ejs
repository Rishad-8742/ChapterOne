<%- include('partials/top', { title: 'Overview', active: 'overview' }) %>

<link rel="stylesheet" href="/css/adminAnalytics.css">

<div class="analytics-dashboard is-loading">

    <!-- Header -->
    <header class="dashboard-header">
        <div>
            <p class="eyebrow">ChapterOne / Admin</p>
            <h2>Analytics Overview</h2>
            <p class="subtitle">
                Monitor revenue, book sales and order performance.
            </p>
        </div>

        <div class="header-actions">
            <p id="analyticsMessage" role="status" aria-live="polite">
                Loading analytics...
            </p>

            <button id="refreshAnalytics" type="button" class="refresh-btn">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
                Refresh data
            </button>
        </div>
    </header>

    <!-- KPI cards -->
    <section class="kpi-grid" aria-label="Key figures">

        <article class="kpi-card" data-tone="indigo">
            <span class="kpi-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 17l6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
            </span>
            <div>
                <span class="kpi-label">Revenue</span>
                <strong id="kpiRevenue" class="kpi-value">&mdash;</strong>
                <small id="kpiRevenueSub" class="kpi-sub">&nbsp;</small>
            </div>
        </article>

        <article class="kpi-card" data-tone="amber">
            <span class="kpi-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2l-2 4v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6l-2-4z"/><path d="M4 6h16"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            </span>
            <div>
                <span class="kpi-label">Total orders</span>
                <strong id="kpiOrders" class="kpi-value">&mdash;</strong>
                <small id="kpiOrdersSub" class="kpi-sub">&nbsp;</small>
            </div>
        </article>

        <article class="kpi-card" data-tone="green">
            <span class="kpi-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h12v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/><path d="M9 7h5"/></svg>
            </span>
            <div>
                <span class="kpi-label">Copies sold</span>
                <strong id="kpiCopies" class="kpi-value">&mdash;</strong>
                <small id="kpiCopiesSub" class="kpi-sub">&nbsp;</small>
            </div>
        </article>

        <article class="kpi-card" data-tone="violet">
            <span class="kpi-icon">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1L3.2 9.5l6.1-.9z"/></svg>
            </span>
            <div>
                <span class="kpi-label">Best seller</span>
                <strong id="kpiBest" class="kpi-value kpi-value--text">&mdash;</strong>
                <small id="kpiBestSub" class="kpi-sub">&nbsp;</small>
            </div>
        </article>

    </section>

    <!-- Charts -->
    <section class="chart-grid">

        <article class="chart-card chart-card--revenue">
            <header class="chart-head">
                <div>
                    <h3>Revenue timeline</h3>
                    <p>Collected revenue per day</p>
                </div>
                <span class="chart-chip">Last 7 days</span>
            </header>
            <div class="chart-container" data-empty="No revenue in this period yet.">
                <canvas id="revenueChart" aria-label="Daily revenue line chart"></canvas>
            </div>
        </article>

        <article class="chart-card chart-card--status">
            <header class="chart-head">
                <div>
                    <h3>Order status</h3>
                    <p>Orders by current status</p>
                </div>
            </header>
            <div class="chart-container" data-empty="No orders yet.">
                <canvas id="statusChart" aria-label="Order status bar chart"></canvas>
            </div>
        </article>

        <article class="chart-card chart-card--genre">
            <header class="chart-head">
                <div>
                    <h3>Sales by genre</h3>
                    <p>Share of copies sold</p>
                </div>
            </header>
            <div class="chart-container chart-container--tall" data-empty="No sales yet.">
                <canvas id="genreChart" aria-label="Sales by genre doughnut chart"></canvas>
            </div>
        </article>

        <article class="chart-card chart-card--books">
            <header class="chart-head">
                <div>
                    <h3>Top performing books</h3>
                    <p>Top 5 by copies sold</p>
                </div>
                <span class="chart-chip">Top 5</span>
            </header>
            <div class="chart-container chart-container--tall" data-empty="No book sales yet.">
                <canvas id="topBooksChart" aria-label="Top five books bar chart"></canvas>
            </div>
        </article>

    </section>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4"></script>
<script src="/js/adminAnalytics.js" defer></script>

<%- include('partials/bottom') %>
