<!-- ACCOUNT PAGE -->
<main class="account-layout">

    <aside class="account-sidebar">
        <p class="sidebar-label">ACCOUNT DASHBOARD</p>
        <h2>My Account</h2>

        <nav class="account-menu">
            <button type="button" class="menu-item active"
                    data-section="profileSection">
                <span>♙</span> Profile
            </button>

         <a href="/user/address" class="menu-item">
    <span>⌂</span> Address
</a>

<a href="/user/orders" class="menu-item">
    <span>▤</span> My Orders
</a>

            <a href="/user/logout" class="menu-item logout-link">
                <span>⇥</span> Logout
            </a>
        </nav>
    </aside>

    <div class="account-content">
        <p id="accountMessage" class="account-message" role="status"></p>

        <!-- PROFILE SECTION -->
        <section class="content-card account-section"
                 id="profileSection">

            <div class="card-heading">
                <h2>Profile</h2>
                <p>Manage your personal account information.</p>
            </div>

            <form id="profileForm">
                <div class="profile-grid">

                    <div class="form-group">
                        <label for="userName">FULL NAME</label>
                        <input type="text" id="userName" name="userName"
                               required minlength="2" maxlength="40">
                    </div>

                    <div class="form-group">
                        <label for="userEmail">EMAIL ADDRESS</label>
                        <input type="email" id="userEmail" name="userEmail"
                               required>
                    </div>

                    <div class="form-group">
                        <label for="phone">PHONE NUMBER</label>
                        <input type="tel" id="phone" name="phone"
                               maxlength="10" inputmode="numeric"
                               placeholder="Enter phone number">
                    </div>

                   

                </div>

                <div class="card-footer">
                    <button type="submit" id="saveProfileBtn">
                        ✓ &nbsp; Save Changes
                    </button>
                </div>
            </form>
        </section>

        <!-- ADDRESS SECTION -->
        <section class="content-card account-section"
                 id="addressSection" hidden>

            <div class="card-heading">
                <h2>My Addresses</h2>
                <p>Manage your delivery information.</p>
            </div>

            <div id="addressList">
                <p class="empty-state">Loading your addresses...</p>
            </div>

            <button type="button" id="toggleAddressForm"
                    class="secondary-button">
                + Add New Address
            </button>

            <form id="addressForm" hidden>
                <h3 id="addressFormTitle">Add Delivery Address</h3>

                <input type="hidden" id="addressId">

                <div class="profile-grid">
                    <div class="form-group">
                        <label for="addressLabel">ADDRESS TYPE</label>
                        <select id="addressLabel" required>
                            <option value="Home">Home</option>
                            <option value="Work">Work</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="addressFullName">RECIPIENT NAME</label>
                        <input id="addressFullName" required
                               minlength="2" maxlength="60">
                    </div>

                    <div class="form-group">
                        <label for="addressPhone">PHONE NUMBER</label>
                        <input id="addressPhone" type="tel"
                               maxlength="10" inputmode="numeric" required>
                    </div>

                    <div class="form-group">
                        <label for="addressCity">CITY</label>
                        <input id="addressCity" required
                               minlength="2" maxlength="60">
                    </div>

                    <div class="form-group">
                        <label for="addressPincode">PIN CODE</label>
                        <input id="addressPincode" maxlength="6"
                               inputmode="numeric" required>
                    </div>

                    <div class="form-group full-width">
                        <label for="addressText">FULL ADDRESS</label>
                        <textarea id="addressText" rows="3"
                                  minlength="10" maxlength="250" required
                                  placeholder="House name, street, area..."></textarea>
                    </div>
                </div>

                <label class="default-option">
                    <input type="checkbox" id="addressDefault">
                    Set as default address
                </label>

                <button type="submit" id="saveAddressBtn">
                    Save Address
                </button>

                <button type="button" id="cancelAddressForm"
                        class="secondary-button">
                    Cancel
                </button>
            </form>
        </section>

        <!-- ORDERS SECTION -->
        <section class="content-card account-section"
                 id="ordersSection" hidden>

            <div class="card-heading">
                <h2>My Orders</h2>
                <p>View your purchases and track your deliveries.</p>
            </div>

            <div id="ordersList">
                <p class="empty-state">
                    Your order history will appear here when connected
                    to your orders API.
                </p>
            </div>
        </section>
    </div>
</main>

