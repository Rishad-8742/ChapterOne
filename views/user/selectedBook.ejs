<%- include('partials/top', {
    pageTitle: 'Selected Book',
    pageCss: '/css/selectedBook.css',
    active: 'books',
    bookId: bookId
}) %>

<main class="page-container">

    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/user/books">Books</a>
        <span aria-hidden="true">/</span>
        <span id="breadcrumbGenre">Loading</span>
        <span aria-hidden="true">/</span>
        <span id="breadcrumbTitle" aria-current="page">Book details</span>
    </nav>

    <section class="product-layout">

        <!-- GALLERY -->
        <div class="image-section">

            <div class="image-card">
                <img id="bookImage" alt="Book cover">
            </div>

            <div class="cover-thumbnails" id="coverThumbnails" hidden>
                <button type="button" id="frontThumb" class="cover-thumb active"
                        aria-label="Show front cover">
                    <img id="frontThumbImage" alt="Front cover thumbnail">
                </button>

                <button type="button" id="backThumb" class="cover-thumb"
                        aria-label="Show back cover" hidden>
                    <img id="backThumbImage" alt="Back cover thumbnail">
                </button>
            </div>

        </div>

        <!-- DETAILS -->
        <div class="details-section">

            <p class="genre" id="bookGenre">Loading...</p>

            <h1 id="bookTitle">Loading book details...</h1>

            <p class="author">By <span id="bookAuthor">—</span></p>

            <div class="price-row">
                <span class="price" id="bookPrice">₹0.00</span>
                <span class="stock-badge" id="stockNote">Checking availability...</span>
            </div>

            <div class="description-wrap">
                <p class="description" id="bookDescription">Loading description...</p>
                <button type="button" id="descToggle" class="desc-toggle"
                        aria-expanded="false" hidden>Read more</button>
            </div>

            <dl class="book-specs" id="bookSpecs" hidden></dl>

            <div class="purchase-row">

                <div class="quantity-control" role="group" aria-label="Quantity">
                    <button type="button" id="decreaseQty"
                            aria-label="Decrease quantity">−</button>
                    <span id="quantity" aria-live="polite">1</span>
                    <button type="button" id="increaseQty"
                            aria-label="Increase quantity">+</button>
                </div>

                <button type="button" id="addToCartBtn" class="add-cart-btn" disabled>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <circle cx="9" cy="20" r="1.4"/>
                        <circle cx="18" cy="20" r="1.4"/>
                        <path d="M2 3h3l2.7 12.4a1 1 0 0 0 1 .8h8.8a1 1 0 0 0 1-.8L20 7H6"/>
                    </svg>
                    <span id="addToCartLabel">Add to Cart</span>
                </button>

            </div>

            <p id="message" role="status" aria-live="polite"></p>

            <ul class="benefits">
                <li class="benefit">
                    <span class="benefit-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="m8 12 3 3 5-6"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Carefully selected</strong>
                        <span>Hand-picked for readers</span>
                    </div>
                </li>

                <li class="benefit">
                    <span class="benefit-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <rect x="4" y="11" width="16" height="10" rx="2"/>
                            <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Secure checkout</strong>
                        <span>Simple, safe ordering</span>
                    </div>
                </li>

                <li class="benefit">
                    <span class="benefit-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M21 8l-9-5-9 5v8l9 5 9-5V8Z"/>
                            <path d="M3 8l9 5 9-5M12 13v8"/>
                        </svg>
                    </span>
                    <div>
                        <strong>Order tracking</strong>
                        <span>Follow every step</span>
                    </div>
                </li>
            </ul>

        </div>

    </section>

    <!-- RELATED BOOKS -->
    <section class="related-books-section">
        <div class="related-books-heading">
            <p class="section-label">MORE TO EXPLORE</p>
            <h2>You May Also Like</h2>
            <p>Discover more books from the same genre.</p>
        </div>

        <div id="relatedBooksContainer" class="related-books-grid">
            <p class="related-empty">Finding books for you...</p>
        </div>
    </section>

</main>

<%- include('partials/bottom', {
    pageScript: '/js/selectedBook.js'
}) %>