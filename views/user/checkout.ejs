<%- include('partials/top', {
    title: 'Checkout Page',
    active: 'Checkout',
    pageCss: '/css/checkout.css'
}) %>
   <main class="checkout-container">

    <ol class="checkout-steps">
        <li class="is-done"><span class="step-num">&#10003;</span><a href="/user/cart">Cart</a></li>
        <li class="is-current"><span class="step-num">2</span>Checkout</li>
        <li><span class="step-num">3</span>Done</li>
    </ol>

    <header class="page-heading">
        <h1>Complete your order</h1>
        <p>Almost there. Choose where to deliver your books.</p>
    </header>

    <form id="checkoutForm" novalidate>
        <div class="checkout-layout">

            <!-- LEFT: address + payment -->
            <div class="checkout-card">

                <section class="checkout-section">
                    <div class="section-head">
                        <h2><span class="section-num">1</span>Shipping details</h2>
                        <a id="addAddressLink" class="section-link" href="/user/account">Manage addresses</a>
                    </div>

                    <select id="savedAddressSelect" hidden>
                        <option value="">Loading saved addresses...</option>
                    </select>

                    <div id="addressOptions" class="address-options">
                        <p class="address-loading">Loading your saved addresses...</p>
                    </div>

                    <p id="addressLoadMessage" class="address-note"></p>
                </section>

                <section class="checkout-section">
                    <div class="section-head">
                        <h2><span class="section-num">2</span>Payment method</h2>
                    </div>

                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="COD" checked>
                        <span class="payment-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/></svg>
                        </span>
                        <span class="payment-text">
                            <strong>Cash on Delivery</strong>
                            <small>Pay when your books arrive.</small>
                        </span>
                    </label>

                    <label class="payment-option">
                        <input type="radio" name="paymentMethod" value="RAZORPAY">
                        <span class="payment-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
                        </span>
                        <span class="payment-text">
                            <strong>Online Payment</strong>
                            <small>Pay securely using Razorpay.</small>
                        </span>
                    </label>
                </section>
            </div>

            <!-- RIGHT: order summary -->
            <aside class="checkout-card order-card">
                <div class="order-head">
                    <h2>Your order</h2>
                    <div class="order-meta">
                        <span id="checkoutItemCount"></span>
                        <a href="/user/cart">Edit cart</a>
                    </div>
                </div>

                <div id="checkoutItems" class="checkout-items">
                    <p class="checkout-loading">Loading your books...</p>
                </div>
<div class="coupon-section">
    <h3>Have a coupon?</h3>

    <!-- AVAILABLE COUPONS -->
    <div class="available-coupons">
        <h4>Available coupons</h4>

        <div id="availableCoupons">
            <p class="coupon-loading">Loading available coupons...</p>
        </div>
    </div>

    <!-- MANUAL COUPON INPUT -->
    <div class="coupon-input-group">
        <input
            type="text"
            id="couponCode"
            placeholder="Enter coupon code"
            maxlength="30"
            autocomplete="off"
        >

        <button type="button" id="applyCouponBtn">
            Apply
        </button>
    </div>

    <p id="couponMessage" role="status" aria-live="polite"></p>

    <!-- APPLIED COUPON -->
    <div id="appliedCoupon" hidden>
        <span id="appliedCouponText"></span>

        <button type="button" id="removeCouponBtn">
            Remove
        </button>
    </div>
</div>
<!-- END COUPON SECTION -->


                <div class="summary-line">
                    <span>Subtotal</span>
                    <span id="checkoutSubtotal">&#8377;0.00</span>
                </div>
                
                <div class="summary-line" id="discountRow" hidden>
    <span>Coupon discount</span>
    <span id="checkoutDiscount">-₹0.00</span>
</div>

                <div class="summary-line">
                    <span>Delivery</span>
                    <span>Free</span>
                </div>

                <div class="summary-line total-line">
                    <strong>Total</strong>
                    <strong id="checkoutTotal">&#8377;0.00</strong>
                </div>

                <div id="checkoutMessage" class="message" role="status" aria-live="polite"></div>

                <button type="submit" id="placeOrderBtn" class="place-order-btn" disabled>Place order</button>

                <p class="secure-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
                    <span>Your order and payment details are processed securely.</span>
                </p>
            </aside>

        </div>
    </form>
</main>

<!-- Razorpay SDK must load BEFORE checkout.js -->
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<%- include('partials/bottom', {
    pageScript: '/js/checkout.js'
}) %>

