
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Cart | ChapterOne</title>

    <link rel="stylesheet" href="/css/cart.css">
    <script src="/js/cart.js" defer></script>
</head>

<body>
   
    <!-- ================= NAVBAR ================= -->

    <header class="navbar">


        <!-- LOGO -->

        <a
            href="/user/home"
            class="logo"
        >

            <span class="logo-icon">

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="#fff"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >

                    <path
                        d="M12 6.5C10.3 5.3 8 4.8 4 5v12c4-.2 6.3.3 8 1.5"
                    />

                    <path
                        d="M12 6.5c1.7-1.2 4-1.7 8-1.5v12c-4-.2-6.3.3-8 1.5"
                    />

                    <path
                        d="M12 6.5v12"
                    />

                </svg>

            </span>


            <span class="logo-text">
                ChapterOne
            </span>

        </a>



        <!-- NAVIGATION -->

        <nav class="navigation">


            <!-- HOME -->

            <a
                href="/user/home"
                class="nav-link"
            >
                Home
            </a>


            <!-- BOOKS -->

            <a
                href="/user/books"
               class="nav-link"
            >
                Books
            </a>


            <!-- CART -->

            <a
                href="/user/cart"
                 class="nav-link active"
            >

                <span class="nav-icon">

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                    >

                        <path
                            d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 7H6"
                        />

                        <circle
                            cx="10"
                            cy="20"
                            r="1"
                        />

                        <circle
                            cx="18"
                            cy="20"
                            r="1"
                        />

                    </svg>

                </span>

                Cart

          

            </a>


            <!-- ACCOUNT -->

            <a
                href="/user/account"
                class="nav-link nav-icon-link"
            >

                <span class="nav-icon">

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                    >

                        <circle
                            cx="12"
                            cy="8"
                            r="3.2"
                        />

                        <path
                            d="M5.5 20c.7-3.7 3-5.5 6.5-5.5s5.8 1.8 6.5 5.5"
                        />

                    </svg>

                </span>

                Account

            </a>


            <!-- LOGOUT -->

            <a
                href="/user/logout"
                class="nav-link nav-icon-link"
            >

                <span class="nav-icon">

                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.7"
                    >

                        <path
                            d="M10 5H5v14h5"
                        />

                        <path
                            d="M14 8l4 4-4 4"
                        />

                        <path
                            d="M8 12h10"
                        />

                    </svg>

                </span>

               

            </a>

        </nav>

    </header>



    <main class="cart-container">
        <div class="cart-heading">
            <div>
                <p class="eyebrow">YOUR SELECTION</p>
                <h1>Shopping Cart</h1>
            </div>

            <p id="cartCount" class="cart-count">0 items</p>
        </div>

        <p id="cartMessage" class="cart-message" role="status"></p>

        <div class="cart-layout">
            <section class="cart-items-section">
                <div class="section-heading">
                    <h2>Your Books</h2>
                </div>

                <div id="cartItems" aria-live="polite">
                    <p class="loading">Loading your cart...</p>
                </div>
            </section>

            <aside class="order-summary">
                <h2>Order Summary</h2>

                <div class="summary-row">
                    <span>Items</span>
                    <span id="summaryQuantity">0</span>
                </div>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">₹0.00</span>
                </div>

                <div class="summary-row">
                    <span>Delivery</span>
                    <span>Calculated at checkout</span>
                </div>

                <div class="summary-total">
                    <span>Total</span>
                    <span id="cartTotal">₹0.00</span>
                </div>

                <button id="checkoutBtn" disabled>
                    Proceed to Checkout
                </button>

                <p class="secure-note">
                    Your next great read is waiting.
                </p>
            </aside>
        </div>
    </main>
</body>
</html>
 