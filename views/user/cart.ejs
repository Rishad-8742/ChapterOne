<%- include('partials/top', {
    title: 'my cart',
    active: 'cart',
    pageCss: '/css/cart.css'
}) %>

    <main class="cart-container">

        <div class="cart-heading">
            <div>
                <p class="eyebrow">YOUR SELECTION</p>
                <h1>Shopping Cart</h1>
                <p id="cartSubtitle" class="cart-subtitle">Loading your cart...</p>
            </div>
        </div>

        <p id="cartMessage" class="cart-message" role="status" aria-live="polite"></p>

        <div class="cart-layout">

            <section class="cart-items-section" aria-label="Books in your cart">
                <div id="cartItems" aria-live="polite">
                    <p class="loading">Loading your cart...</p>
                </div>
            </section>

            <aside class="order-summary" aria-label="Order summary">
                <h2>Order Summary</h2>

                <div class="summary-row items-summary">
                    <span class="items-label">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                             aria-hidden="true">
                            <path d="M12 6.5C10.5 5 8 4.5 4 4.5v13c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2v-13c-4 0-6.5.5-8 2Z"/>
                            <path d="M12 6.5v13"/>
                        </svg>
                        Items in Cart
                    </span>
                    <span id="summaryQuantity" class="items-count">0</span>
                </div>

                <div class="summary-row">
                    <span>Subtotal</span>
                    <span id="cartSubtotal">₹0.00</span>
                </div>

                <div class="summary-row">
                    <span>Delivery</span>
                    <span>Calculated at checkout</span>
                </div>

                <div class="summary-total">
                    <span>Total</span>
                    <span id="cartTotal">₹0.00</span>
                </div>

                <button type="button" id="checkoutBtn" disabled>
                    Proceed to Checkout
                </button>

                <p class="secure-note">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
                         aria-hidden="true">
                        <rect x="4" y="11" width="16" height="10" rx="2"/>
                        <path d="M8 11V8a4 4 0 0 1 8 0v3"/>
                    </svg>
                    Secure checkout
                </p>
                <p class="summary-tagline">Your next great read is waiting.</p>

                <a href="/user/books" class="summary-link">← Continue shopping</a>
            </aside>

        </div>
    </main>

<%- include('partials/bottom', {
    pageScript: '/js/cart.js'
}) %>