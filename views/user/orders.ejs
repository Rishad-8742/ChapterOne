<%- include('partials/top', {
    pageTitle: 'My Orders',
    pageCss: '/css/account.css',
    active: 'account'
}) %>

<main class="account-layout orders-layout">

    <!-- ACCOUNT SIDEBAR -->
    <%- include('partials/sidebar', { sidebarActive: 'orders' }) %>

    <!-- ORDERS CONTENT -->
    <section class="content-card orders-content">

        <header class="orders-header">
            <p class="orders-eyebrow">YOUR SHOPPING JOURNEY</p>
            <h1 class="orders-title">My Orders</h1>
            <p class="orders-subtitle">
                Track your orders and stay updated on your purchases.
            </p>
        </header>

        <!-- ORDER FILTERS -->
        <div class="order-toolbar">
            <div class="order-filters" role="group" aria-label="Filter orders">
                <button type="button" class="filter-btn active" data-status="all" aria-pressed="true">All</button>
                <button type="button" class="filter-btn" data-status="active" aria-pressed="false">In progress</button>
                <button type="button" class="filter-btn" data-status="delivered" aria-pressed="false">Delivered</button>
                <button type="button" class="filter-btn" data-status="cancelled" aria-pressed="false">Cancelled</button>
            </div>
            <p class="orders-caption" id="ordersCount"></p>
        </div>

        <!-- MESSAGE -->
        <p id="ordersMessage" class="account-message" role="status"></p>

        <!-- ORDER SUMMARY CARDS -->
        <div id="ordersList" aria-live="polite">
            <p class="empty-state">Loading your orders...</p>
        </div>

    </section>
</main>

<!-- ORDER DETAILS MODAL -->
<div class="order-modal" id="orderModal" hidden>
    <div class="order-modal-backdrop" data-close-modal></div>

    <div class="order-modal-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="orderModalTitle"
         tabindex="-1">

        <header class="order-modal-header">
            <div>
                <p class="order-modal-eyebrow">ORDER DETAILS</p>
                <h2 id="orderModalTitle" class="order-modal-title"></h2>
                <p id="orderModalSub" class="order-modal-sub"></p>
            </div>
            <button type="button" class="order-modal-close" data-close-modal aria-label="Close order details">&times;</button>
        </header>

        <div class="order-modal-body" id="orderModalBody"></div>

        <footer class="order-modal-footer">
            <button type="button" class="secondary-button" data-close-modal>Close</button>
        </footer>
    </div>
</div>

<%- include('partials/bottom', {
    pageScript: '/js/orders.js'
}) %>