
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>ChapterOne | Login</title>

    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

    <div class="login-card">

        <!-- Brand -->

        <div class="brand">
            CHAPTERONE
        </div>

        <!-- Heading -->

        <h1>Welcome Back</h1>

        <p class="subtitle">
            Sign in to continue your reading journey.
        </p>


        <!-- Google Authentication -->

        <a href="/auth/google/login" class="google-btn">

            <svg class="google-icon"
                 viewBox="0 0 48 48"
                 aria-hidden="true">

                <path fill="#EA4335"
                      d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>

                <path fill="#4285F4"
                      d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.76 7.18l7.73 6C44.42 37.98 46.98 31.8 46.98 24.55z"/>

                <path fill="#FBBC05"
                      d="M10.53 28.59A14.4 14.4 0 0 1 9.75 24c0-1.59.27-3.13.76-4.59l-7.98-6.19A23.9 23.9 0 0 0 0 24c0 3.87.93 7.52 2.56 10.78l7.97-6.19z"/>

                <path fill="#34A853"
                      d="M24 48c6.48 0 11.93-2.13 15.91-5.8l-7.73-6c-2.15 1.45-4.92 2.3-8.18 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>

            </svg>

            <span>Continue with Google</span>

        </a>


        <!-- Divider -->

        <div class="divider">
            <span>OR SIGN IN WITH EMAIL</span>
        </div>


        <!-- Login Form -->

        <form id="loginForm">

            <!-- Email -->

            <div class="form-group">

                <label for="userEmail">
                    EMAIL ADDRESS
                </label>

                <input
                    type="email"
                    id="userEmail"
                    name="userEmail"
                    placeholder="Enter your email"
                    autocomplete="email"
                    required
                >

            </div>


            <!-- Password -->

            <div class="form-group">

                <label for="userPassword">
                    PASSWORD
                </label>

                <input
                    type="password"
                    id="userPassword"
                    name="userPassword"
                    placeholder="Enter your password"
                    autocomplete="current-password"
                    required
                >

            </div>
            <!-- Login Button -->

            <button type="submit" class="login-btn">
                Login →
            </button>

        </form>


        <!-- Signup Link -->

        <div class="signup-section">

            Don't have an account?

            <a href="/user/signup">
                Create Account
            </a>

        </div>

    </div>

<script src="/js/login.js" defer></script>
</body>

</html>