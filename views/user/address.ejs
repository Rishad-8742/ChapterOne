<main class="account-layout">

    <aside class="account-sidebar">
        <p class="sidebar-label">ACCOUNT DASHBOARD</p>
        <h2>My Account</h2>

        <nav class="account-menu">
            <a href="/user/account" class="menu-item">
                <span>♙</span> Profile
            </a>
            <a href="/user/address" class="menu-item active">
                <span>⌂</span> Address
            </a>
            <a href="/user/orders" class="menu-item">
                <span>▤</span> My Orders
            </a>
            <a href="/user/logout" class="menu-item logout-link">
                <span>⇥</span> Logout
            </a>
        </nav>
    </aside>

    <section class="content-card address-content">
        <div class="card-heading">
            <div>
                <h2>My Addresses</h2>
                <p>Manage your saved delivery addresses.</p>
            </div>
        </div>

        <p id="addressMessage" class="account-message" role="status"></p>

        <div id="addressList" class="address-list">
            <p class="empty-state">Loading your addresses...</p>
        </div>

        <button type="button" id="toggleAddressForm" class="primary-button">
            + Add New Address
        </button>

        <form id="addressForm" hidden>
            <h3 id="addressFormTitle">Add Delivery Address</h3>

            <input type="hidden" id="addressId">

            <div class="profile-grid">
                <div class="form-group">
                    <label for="addressLabel">ADDRESS TYPE</label>
                    <select id="addressLabel" required>
                        <option value="Home">Home</option>
                        <option value="Work">Work</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="addressFullName">RECIPIENT NAME</label>
                    <input id="addressFullName" required minlength="2" maxlength="60">
                </div>

                <div class="form-group">
                    <label for="addressPhone">PHONE NUMBER</label>
                    <input id="addressPhone" type="tel" maxlength="10" inputmode="numeric" required>
                </div>

                <div class="form-group">
                    <label for="addressCity">CITY</label>
                    <input id="addressCity" required minlength="2" maxlength="60">
                </div>

                <div class="form-group">
                    <label for="addressPincode">PIN CODE</label>
                    <input id="addressPincode" maxlength="6" inputmode="numeric" required>
                </div>

                <div class="form-group full-width">
                    <label for="addressText">FULL ADDRESS</label>
                    <textarea id="addressText" rows="3" minlength="10" maxlength="250" required placeholder="House name, street, area..."></textarea>
                </div>
            </div>

            <label class="default-option">
                <input type="checkbox" id="addressDefault">
                Set as default delivery address
            </label>

            <div class="form-actions">
                <button type="submit" id="saveAddressBtn" class="primary-button">
                    Save Address
                </button>
                <button type="button" id="cancelAddressForm" class="secondary-button">
                    Cancel
                </button>
            </div>
        </form>
    </section>

</main>

