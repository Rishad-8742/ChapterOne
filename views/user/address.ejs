<%- include('partials/top', {
    pageTitle: 'My Addresses',
    pageCss: '/css/account.css',
    active: 'account'
}) %>

<main class="account-layout">

    <%- include('partials/sidebar', { sidebarActive: 'address' }) %>

    <section class="content-card address-content">
        <div class="card-heading card-heading--action">
            <div>
                <h2>My Addresses</h2>
                <p>Manage your saved delivery addresses.</p>
            </div>

            <button type="button" id="toggleAddressForm" class="primary-button add-address-btn">
                <span aria-hidden="true">+</span> Add New Address
            </button>
        </div>

        <p id="addressMessage" class="account-message" role="status" aria-live="polite"></p>

        <div id="addressList" class="addr-grid">
        <p class="addr-empty">Loading your addresses...</p>
        </div>

        <form id="addressForm" hidden>
            <h3 id="addressFormTitle">Add Delivery Address</h3>

            <input type="hidden" id="addressId">

            <div class="profile-grid">
                <div class="form-group full-width">
                    <label for="addressLabel">ADDRESS TYPE</label>
                    <select id="addressLabel" name="label" required>
                        <option value="Home">Home</option>
                        <option value="Work">Work</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="addressFullName">RECIPIENT NAME</label>
                    <input id="addressFullName" name="fullName" type="text" autocomplete="name"
                           required minlength="2" maxlength="60" placeholder="Full name">
                </div>

                <div class="form-group">
                    <label for="addressPhone">PHONE NUMBER</label>
                    <input id="addressPhone" name="phone" type="tel" autocomplete="tel-national"
                           inputmode="numeric" maxlength="10" pattern="[0-9]{10}"
                           title="Enter a 10-digit phone number" required placeholder="10-digit mobile number">
                </div>

                <div class="form-group">
                    <label for="addressPincode">PIN CODE</label>
                    <input id="addressPincode" name="pincode" type="text" autocomplete="postal-code"
                           inputmode="numeric" maxlength="6" pattern="[0-9]{6}"
                           title="Enter a 6-digit PIN code" required placeholder="6-digit PIN code">
                </div>

                <div class="form-group">
                    <label for="addressCity">CITY</label>
                    <input id="addressCity" name="city" type="text" autocomplete="address-level2"
                           required minlength="2" maxlength="60" placeholder="City or town">
                </div>

                <div class="form-group full-width">
                    <label for="addressText">FULL ADDRESS</label>
                    <textarea id="addressText" name="address" rows="3" autocomplete="street-address"
                              minlength="10" maxlength="250" required
                              placeholder="House name, street, area..."></textarea>
                    <small>Include landmarks to help delivery.</small>
                </div>
            </div>

            <label class="default-option">
                <input type="checkbox" id="addressDefault">
                Set as default delivery address
            </label>

            <div class="form-actions">
                <button type="submit" id="saveAddressBtn" class="primary-button">
                    Save Address
                </button>
                <button type="button" id="cancelAddressForm" class="secondary-button">
                    Cancel
                </button>
            </div>
        </form>
    </section>

</main>

<%- include('partials/bottom', {
    pageScript: '/js/address.js'
}) %>