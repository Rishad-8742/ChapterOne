<%- include('partials/top', {
    title: 'home',
    active: 'home',
    pageCss: '/css/home.css'
}) %>

<main class="home">

    <!-- ================= HERO ================= -->
    <section class="hero">

        <div class="hero-content">
            <div class="hero-label">
                READ <b>•</b> DISCOVER <b>•</b> IMAGINE
            </div>

            <h1>Every Book Opens a <em>New World.</em></h1>

            <p class="hero-description">
                Stories can take us places, introduce us to new ideas,
                and change the way we see the world.
            </p>

            <div class="hero-buttons">
                <a href="/user/books" class="primary-button">
                    Explore Books <span>→</span>
                </a>
                <a href="#new-arrivals" class="secondary-button">
                    See what's new
                </a>
            </div>
        </div>

        <div class="hero-visual">
            <div class="hero-image-wrapper">
                <img
                    src="/images/book%20cover%20img%202.jpg"
                    alt="Open book in a cozy library"
                    class="hero-image"
                >
                <div class="image-overlay"></div>
            </div>

<div class="hero-float">
    <span class="hero-float-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
    </span>
    <span>
        <strong>Cash on Delivery</strong>
        <small>Pay when your books arrive</small>
    </span>
</div>
        </div>

    </section>

    <!-- ================= TRUST STRIP ================= -->
    <section class="trust-strip" data-reveal>
        <div class="trust-item">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/></svg>
            </span>
            <div><strong>Free Delivery</strong><span>Straight to your door</span></div>
        </div>

        <div class="trust-item">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/></svg>
            </span>
            <div><strong>Cash on Delivery</strong><span>Pay when it arrives</span></div>
        </div>

        <div class="trust-item">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>
            </span>
            <div><strong>Secure Payments</strong><span>Powered by Razorpay</span></div>
        </div>

        <div class="trust-item">
            <span class="trust-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H20v17H7.5A3.5 3.5 0 0 0 4 22V5.5Z"/><path d="M4 5.5A3.5 3.5 0 0 0 7.5 9H20"/></svg>
            </span>
            <div><strong>Handpicked Books</strong><span>Stories worth reading</span></div>
        </div>
    </section>

    <!-- ================= NEW ARRIVALS ================= -->
    <section class="new-arrivals" id="new-arrivals">

        <div class="section-heading" data-reveal>
            <div>
                <p class="section-label">FRESH OFF THE SHELF</p>
                <h2>New Arrivals</h2>
                <p>Discover the latest additions to our collection.</p>
            </div>

            <a href="/user/books" class="view-all">View all books <span>→</span></a>
        </div>

        <div id="newArrivalsContainer" class="book-grid">
            <div class="book-card skeleton"></div>
            <div class="book-card skeleton"></div>
            <div class="book-card skeleton"></div>
        </div>

    </section>

    <!-- ================= QUOTE CARD ================= -->
    <section class="quote-section" data-reveal>
        <div class="quote-card">
            <span class="quote-mark">“</span>

            <blockquote class="card-quote">
                There is no friend as loyal as a book.
            </blockquote>

            <p class="card-author">Ernest Hemingway</p>

            <span class="card-divider"></span>

            <h2>Your Next Story Is Waiting.</h2>

            <p class="card-text">
                Discover a book that becomes part of your story.
            </p>

            <a href="/user/books" class="card-button">
                Explore Books <span>→</span>
            </a>
        </div>
    </section>

    <!-- ================= WHY CHAPTERONE ================= -->
    <section class="why-section">

        <div class="why-heading" data-reveal>
            <p class="why-label">THE CHAPTERONE EXPERIENCE</p>
            <h2>Why Choose ChapterOne?</h2>
            <span class="heading-line"></span>
        </div>

        <div class="why-cards" data-reveal>

            <article class="why-card">
                <div class="why-card-top">
                    <span class="why-number">01</span>
                    <span class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="8"/><path d="M4 12h16"/><path d="M12 4c2.2 2.2 3.3 4.8 3.3 8S14.2 17.8 12 20"/><path d="M12 4c-2.2 2.2-3.3 4.8-3.3 8S9.8 17.8 12 20"/></svg>
                    </span>
                </div>
                <h3>To Discover</h3>
                <p>Explore stories, ideas and perspectives that take you beyond your everyday world.</p>
            </article>

            <article class="why-card">
                <div class="why-card-top">
                    <span class="why-number">02</span>
                    <span class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 5.5A3.5 3.5 0 0 1 7.5 2H20v17H7.5A3.5 3.5 0 0 0 4 22V5.5Z"/><path d="M4 5.5A3.5 3.5 0 0 0 7.5 9H20"/></svg>
                    </span>
                </div>
                <h3>To Find Your Next</h3>
                <p>Discover books that match your interests, your mood, and the chapter you're in.</p>
            </article>

            <article class="why-card">
                <div class="why-card-top">
                    <span class="why-number">03</span>
                    <span class="why-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l1.4 5.6L19 10l-5.6 1.4L12 17l-1.4-5.6L5 10l5.6-1.4L12 3Z"/><path d="M19 15l.6 2.4L22 18l-2.4.6L19 21l-.6-2.4L16 18l2.4-.6L19 15Z"/></svg>
                    </span>
                </div>
                <h3>To Imagine</h3>
                <p>Let stories open new worlds and give your imagination somewhere to travel.</p>
            </article>

        </div>
    </section>

</main>

<%- include('partials/bottom', {
    pageScript: '/js/home.js'
}) %>