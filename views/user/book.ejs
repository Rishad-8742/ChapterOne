<%- include('partials/top', {
    title: 'book',
    active: 'book',
    pageCss: '/css/book.css'
}) %>

<main class="books-page">

    <!-- PAGE INTRO -->
    <section class="books-header">
        <p class="section-label">THE CHAPTERONE COLLECTION</p>
        <h1>Find Your Next Chapter</h1>
        <p class="books-description">
            Explore stories, ideas, and worlds waiting to be discovered.
        </p>
    </section>

    <!-- ================= FILTER PANEL ================= -->
    <section class="filter-panel" aria-label="Search and filter books">

        <!-- Row 1: search, genre, language -->
        <div class="filter-row filter-row--top">

            <div class="filter-field">
                <label for="searchInput">Search</label>
                <div class="search-box">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.7">
                        <circle cx="11" cy="11" r="7" />
                        <path d="m20 20-4-4" />
                    </svg>
                    <input type="text" id="searchInput"
                           placeholder="Search by title or author..."
                           autocomplete="off">
                </div>
            </div>

            <div class="filter-field">
                <label for="genreFilter">Genre</label>
                <select id="genreFilter" class="form-input">
                    <option value="">All Genres</option>
                    <option value="Fiction">Fiction</option>
                    <option value="Mystery">Mystery</option>
                    <option value="Romance">Romance</option>
                    <option value="Science Fiction">Science Fiction</option>
                    <option value="Fantasy">Fantasy</option>
                    <option value="Self Help">Self Help</option>
                </select>
            </div>

            <div class="filter-field">
                <label for="languageFilter">Language</label>
                <select id="languageFilter" class="form-input">
                    <option value="">All Languages</option>
                    <option value="English">English</option>
                    <option value="Malayalam">Malayalam</option>
                    <option value="Hindi">Hindi</option>
                </select>
            </div>

        </div>

        <!-- Row 2: sort, price range, result count + reset -->
        <div class="filter-row filter-row--bottom">

            <div class="filter-field sort-control">
                <label for="newest">Sort by</label>
                <select id="newest">
                    <option value="">New Collection</option>
                    <option value="price-low">Price: Low to High</option>
                    <option value="price-high">Price: High to Low</option>
                    <option value="az">A–Z</option>
                </select>
            </div>

            <div class="price-filter">
                <div class="price-heading">
                    <label for="priceRange">Price range</label>
                    <span class="price-display">₹0 – <span id="priceValue">₹1000</span></span>
                </div>

                <input type="range" id="priceRange"
                       min="0" max="1000" step="50" value="1000">

                <div class="price-labels">
                    <span>₹0</span>
                    <span id="priceMaxLabel">₹1000</span>
                </div>
            </div>

            <div class="filter-summary">
                <p id="bookCount">Loading books...</p>
                <button type="button" id="resetFilters" class="reset-btn" hidden>
                    Reset filters
                </button>
            </div>

        </div>

    </section>

    <!-- ================= BOOK GRID ================= -->
    <section class="books-section">

        <div id="loading" class="loading">
            <div class="loading-spinner"></div>
            <p>Discovering books...</p>
        </div>

        <div id="bookContainer" class="book-grid"></div>

        <div id="noBooks" class="no-books" style="display: none;">
            <div class="no-books-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v17H6.5A2.5 2.5 0 0 0 4 22V5.5Z" />
                    <path d="M4 18.5A2.5 2.5 0 0 1 6.5 16H20" />
                </svg>
            </div>
            <h2>No Books Found</h2>
            <p>Try another search or choose a different genre or language.</p>
        </div>

    </section>

</main>

<%- include('partials/bottom', {
    pageScript: '/js/book.js'
}) %>