
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ChapterOne' : 'ChapterOne | Every Story Starts Here' %>
    </title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <% if (typeof pageCss !== 'undefined' && pageCss) { %>
    <link rel="stylesheet" href="<%= pageCss %>">
<% } %>

<link rel="stylesheet" href="/css/navbar.css">
</head>

<body data-book-id="<%= typeof bookId !== 'undefined' ? bookId : '' %>">

    <!-- ================= NAVBAR ================= -->

    <header class="navbar">

        <a href="/user/home" class="logo">

            <span class="logo-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 6.5C10.3 5.3 8 4.8 4 5v12c4-.2 6.3.3 8 1.5"/>
                    <path d="M12 6.5c1.7-1.2 4-1.7 8-1.5v12c-4-.2-6.3.3-8 1.5"/>
                    <path d="M12 6.5v12"/>
                </svg>
            </span>

            <span class="logo-text">ChapterOne</span>

        </a>

        <nav class="navigation">

            <a href="/user/home" class="nav-link">
                Home
            </a>

            <a href="/user/books" class="nav-link">
                Books
            </a>

            <a href="/user/cart" class="nav-link nav-icon-link">

                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 2-1.6L21 7H6"/>
                        <circle cx="10" cy="20" r="1"/>
                        <circle cx="18" cy="20" r="1"/>
                    </svg>
                </span>

                Cart

                <span id="cartCount" class="cart-count">0</span>

            </a>

            <a href="/user/account" class="nav-link nav-icon-link">

                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <circle cx="12" cy="8" r="3.2"/>
                        <path d="M5.5 20c.7-3.7 3-5.5 6.5-5.5s5.8 1.8 6.5 5.5"/>
                    </svg>
                </span>

                Account

            </a>

            <a href="/user/logout" class="nav-link nav-icon-link">

                <span class="nav-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                        <path d="M10 5H5v14h5"/>
                        <path d="M14 8l4 4-4 4"/>
                        <path d="M8 12h10"/>
                    </svg>
                </span>

            </a>

        </nav>

    </header>
