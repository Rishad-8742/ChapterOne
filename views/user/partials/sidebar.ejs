<%
    // sidebarActive: 'profile' | 'address' | 'orders'
    const sbUser = locals.user || {};
    const sbName = sbUser.name || sbUser.fullName || sbUser.username || '';
    const sbInitial = sbName ? String(sbName).trim().charAt(0).toUpperCase() : '';
    const sbActive = locals.sidebarActive || '';
%>
<aside class="account-sidebar">

    <div class="sidebar-profile">
            
        <div class="sidebar-profile-text">
            <p class="sidebar-label">ACCOUNT DASHBOARD</p>
            <h2>My Account</h2>
            <% if (sbName) { %><p class="sidebar-name"><%= sbName %></p><% } %>
        </div>
    </div>

    <nav class="account-menu" aria-label="Account">

        <a href="/user/account" class="menu-item<%= sbActive === 'profile' ? ' active' : '' %>"<%- sbActive === 'profile' ? ' aria-current="page"' : '' %>>
            <span class="menu-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-8 8-8s8 3.6 8 8"/></svg>
            </span>
            <span class="menu-text">Profile</span>
        </a>

        <a href="/user/address" class="menu-item<%= sbActive === 'address' ? ' active' : '' %>"<%- sbActive === 'address' ? ' aria-current="page"' : '' %>>
            <span class="menu-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
            </span>
            <span class="menu-text">Addresses</span>
        </a>

        <a href="/user/orders" class="menu-item<%= sbActive === 'orders' ? ' active' : '' %>"<%- sbActive === 'orders' ? ' aria-current="page"' : '' %>>
            <span class="menu-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3 8l9 5 9-5"/><path d="M12 13v8"/></svg>
            </span>
            <span class="menu-text">My Orders</span>
        </a>

        <div class="menu-divider" aria-hidden="true"></div>

        <a href="/user/logout" class="menu-item logout-link">
            <span class="menu-icon">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg>
            </span>
            <span class="menu-text">Logout</span>
        </a>

    </nav>
</aside>